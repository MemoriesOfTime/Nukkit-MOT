<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <TerminalConsole name="Console">
            <PatternLayout pattern="%cyan{%d{HH:mm:ss}} [%yellow{%t}] [%style{%highlight{%level}}] %bedrockFormatting{%msg}%n"/>
        </TerminalConsole>
        <RollingRandomAccessFile name="File" fileName="logs/server.log" filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyy-MM-dd HH:mm:ss.SSS} [%t] %level - %bedrockFormatting{%msg}{strip}%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <OnStartupTriggeringPolicy/>
            </Policies>
            <!-- Keep every rolled log. The default strategy caps the index at 7 per day and
                 renumbers on rollover, so the eighth restart of a day silently deletes the
                 oldest archive. Prune only when the archives together exceed 1 GB. -->
            <DefaultRolloverStrategy fileIndex="nomax">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName glob="*.log.gz">
                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingRandomAccessFile>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
