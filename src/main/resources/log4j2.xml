<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <TerminalConsole name="Console">
            <PatternLayout pattern="%cyan{%d{HH:mm:ss}} [%yellow{%t}] [%style{%highlight{%level}}] %bedrockFormatting{%msg}%n"/>
        </TerminalConsole>
        <RollingRandomAccessFile name="File" fileName="logs/server.log" filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyy-MM-dd HH:mm:ss.SSS} [%t] %level - %bedrockFormatting{%msg}{strip}%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <OnStartupTriggeringPolicy/>
            </Policies>
            <!-- Keep every rolled log. The default strategy caps the index at 7 per day and
                 renumbers on rollover, so the eighth restart of a day silently deletes the
                 oldest archive. Prune only when the archives together exceed 1 GB. -->
            <DefaultRolloverStrategy fileIndex="nomax">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName glob="*.log.gz">
                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingRandomAccessFile>
        <!-- The thread that logs never writes to the disk or the terminal itself. A plain
             write() into logs/server.log can block for seconds while a spinning disk is busy
             (1.5 s on the main thread, 2026-09-24), and every such second is a lost second of
             ticks. One queue serves both targets, so console and file keep the same order.
             blocking="true" keeps every line: only a completely full queue makes the caller
             wait, which is exactly what the direct appenders did on every line. The timeout
             bounds the final flush, so a dead disk cannot hang the stop forever. -->
        <Async name="Async" bufferSize="8192" blocking="true" shutdownTimeout="10000">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Async>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Async"/>
        </Root>
    </Loggers>
</Configuration>
